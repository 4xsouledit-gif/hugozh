      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": []
    },
    {
      "name": "about",
      "git_path": "/content/about/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": []
    },
    {
      "name": "news",
      "git_path": "/content/news/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": []
    },
    {
      "name": "skill",
