# ── Hugo 构建产物与缓存（可随时用 hugo 重新生成，不入库）──
public/
resources/
.hugo_build.lock
hugo_stats.json

# ── 上游文档克隆（只读参考，另行 clone，不属于本仓库）──
hugoDocs/

# ── DSH 本地状态 ──
.dsh/sessions/
.dsh-write-probe.txt

# ── 编辑器与系统 ──
.DS_Store
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# 代理验证构建的临时输出（不入库）
.translation/_verify*/

# 文件权限诊断报告与一次性迁移的改动前副本（都不属于源码）
.acl-report/
.translation/.teach-migration-backup/

# 代理验证构建的临时目录（不入库）
.tmp-verify*/
.tmpcheck*/
.translation_tmp_verify*/
.tmp*/

# Playwright 测试的依赖与截图（不入库）
.testing/node_modules/
.testing/*.png

# Node 工具依赖（Playwright，用于品牌资产与回归测试）
node_modules/
